<UserControl x:Class="EldoradoApp.Views.Pages.ExtrasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EldoradoApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ExtrasViewModel}"
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Intro -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="SUPPLEMENTI PER RICHIESTE PERSONALIZZATE" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Ogni riga è un'opzione che il compratore può chiedere. Se una delle parole chiave compare nella richiesta, il supplemento viene aggiunto al prezzo in automatico. «Fisso» somma un importo in valuta (es. DuoQ +5), «Percentuale» aggiunge una percentuale del prezzo rank (es. +25%). Con «Sempre» il supplemento si applica a ogni offerta, anche senza parole chiave." />
            </StackPanel>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="32"
                            Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                            <TextBlock Text="Nuovo extra" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="32" Margin="8,0,0,0"
                            Command="{Binding RemoveCommand}" CommandParameter="{Binding Selected}"
                            Content="Elimina selezionato" />
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="32" Margin="8,0,0,0"
                            Command="{Binding RestoreDefaultsCommand}" Content="Ripristina elenco predefinito"
                            Foreground="{StaticResource AppTextDim}" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Extras}" SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                          HorizontalGridLinesBrush="{StaticResource AppBorder}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Attivo" Width="62">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Nome" Width="190"
                                            Binding="{Binding Label, UpdateSourceTrigger=LostFocus}" />

                        <DataGridTextColumn Header="Parole chiave (separate da virgola)" Width="*"
                                            Binding="{Binding Keywords, UpdateSourceTrigger=LostFocus}" />

                        <DataGridTemplateColumn Header="Tipo" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Kinds,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Importo / %" Width="110"
                                            Binding="{Binding Amount, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />

                        <DataGridTemplateColumn Header="Sempre" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding AlwaysApply, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Tester -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="PROVA SU UNA RICHIESTA" Style="{StaticResource CardTitle}" />
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Incolla qui il titolo di una richiesta reale"
                             Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding TestResult}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TestTotal}" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Right" Foreground="{StaticResource AppMint}" />
                    <Button Margin="0,10,0,0" Height="34" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource AppAccent}" BorderBrush="{StaticResource AppAccent}"
                            Foreground="White" Command="{Binding SaveCommand}" Content="Salva extra" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
