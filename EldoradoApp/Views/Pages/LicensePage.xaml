<UserControl x:Class="EldoradoApp.Views.Pages.LicensePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EldoradoApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LicenseViewModel}"
             d:DesignHeight="740" d:DesignWidth="1200">

    <Grid Margin="22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: state and renewal ===== -->
        <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource AppAccent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AppMint}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AppGold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Headline}" Margin="9,0,0,0" FontWeight="SemiBold"
                                           VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="28" Padding="12,0" Command="{Binding RecheckCommand}"
                                    Foreground="{StaticResource AppTextDim}" Content="Ricontrolla" />
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" FontSize="12.5" Text="{Binding Detail}" />

                        <!-- Key facts, one row of tiles -->
                        <UniformGrid Columns="3" Margin="0,16,0,0">
                            <Border Background="{StaticResource AppSurfaceAlt}" CornerRadius="8" Padding="12,10"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="GIORNI RESIDUI" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource AppTextDim}" />
                                    <TextBlock Text="{Binding DaysLeftText}" FontSize="22" FontWeight="Bold"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource AppSurfaceAlt}" CornerRadius="8" Padding="12,10"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="SCADENZA" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource AppTextDim}" />
                                    <TextBlock Text="{Binding Expiry}" FontSize="16" FontWeight="Bold"
                                               Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource AppSurfaceAlt}" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="CODICE CHIAVE" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource AppTextDim}" />
                                    <TextBlock Text="{Binding KeyId}" FontSize="16" FontWeight="Bold"
                                               Margin="0,7,0,0" FontFamily="Consolas, Courier New" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="{Binding DeviceText}" />
                    </StackPanel>
                </Border>

                <!-- Renewal -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RINNOVA O SOSTITUISCI LA CHIAVE" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Alla scadenza ti mando una chiave nuova su Discord: incollala qui e il conto riparte. La vecchia si sostituisce da sola, non serve disinstallare niente." />

                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Incolla qui la nuova chiave (ELDO-...)"
                                 Text="{Binding KeyInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="130"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Courier New" FontSize="12" />

                        <WrapPanel Margin="0,12,0,0">
                            <Button Height="38" Padding="22,0" Margin="0,0,10,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource AppAccent}" BorderBrush="{StaticResource AppAccent}"
                                    Foreground="White" Command="{Binding ActivateCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="KeyVariant" VerticalAlignment="Center" />
                                    <TextBlock Text="Applica chiave" Margin="9,0,0,0" VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Height="38" Padding="16,0" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding PasteKeyCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentPaste" VerticalAlignment="Center" />
                                    <TextBlock Text="Incolla" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Border Background="#33FF4655" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Hint}" Foreground="#FFCDD2" Text="{Binding Detail}" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== Right: machine, contact, danger zone ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ID DI QUESTO PC" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Serve per emettere una chiave su misura per questo computer. Se cambi PC, mandami quello nuovo e ti rifaccio la chiave." />

                        <Border Background="{StaticResource AppSurfaceAlt}" CornerRadius="8" Padding="14,11">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}"
                                        Height="30" Width="30" ToolTip="Copia l'ID macchina"
                                        Foreground="{StaticResource AppMint}"
                                        Command="{Binding CopyMachineIdCommand}">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" />
                                </Button>
                                <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="{StaticResource AppText}" VerticalAlignment="Center"
                                         FontFamily="Consolas, Courier New" FontSize="15" FontWeight="Bold" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ASSISTENZA E RINNOVI" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Chiavi, rinnovi e cambio PC si gestiscono solo su Discord." />

                        <Border Background="{StaticResource AppSurfaceAlt}" CornerRadius="8" Padding="14,11"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Forum" Width="20" Height="20"
                                                         VerticalAlignment="Center" Foreground="#7289DA" />
                                <TextBlock Text="{Binding DiscordContact}" Margin="12,0,0,0" FontSize="14"
                                           FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Height="34" Padding="16,0" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding CopyDiscordCommand}" Content="Copia contatto" />
                            <Button Height="34" Padding="16,0" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Visibility="{Binding HasDiscordInvite, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenDiscordCommand}" Content="Apri Discord" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource AppMint}"
                                   Text="{Binding CopyHint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RIMOZIONE" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Toglie la chiave da questo PC. Usalo solo se stai passando a un altro computer: al prossimo avvio l'app richiede di nuovo l'attivazione." />
                        <Button HorizontalAlignment="Left" Height="32" Padding="16,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource AppAccent}"
                                Command="{Binding RemoveLicenseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LinkVariantOff" VerticalAlignment="Center" />
                                <TextBlock Text="Rimuovi licenza da questo PC" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
