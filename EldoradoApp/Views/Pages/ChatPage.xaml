<UserControl x:Class="EldoradoApp.Views.Pages.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:vm="clr-namespace:EldoradoApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}"
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Explanation -->
        <Border Grid.Row="0" Background="#22FFC857" CornerRadius="10" Padding="14,11" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Hint}" Foreground="#FFE0A0"
                       Text="Questa è la chat di Eldorado dentro l'app: accedi qui una volta e resti loggato. È il canale che il bot usa per mandare in automatico il messaggio con il banner subito dopo ogni offerta. Tieni aperta la conversazione del compratore per l'invio automatico." />
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource AppSurface}" CornerRadius="10" Padding="10,8"
                BorderBrush="{StaticResource AppBorder}" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignIconButton}" Height="30" Width="30" Padding="0"
                            Click="Back_Click" ToolTip="Indietro" Foreground="{StaticResource AppTextDim}">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="17" Height="17" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Height="30" Width="30" Padding="0"
                            Click="Forward_Click" ToolTip="Avanti" Foreground="{StaticResource AppTextDim}">
                        <materialDesign:PackIcon Kind="ArrowRight" Width="17" Height="17" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Height="30" Width="30" Padding="0"
                            Click="Reload_Click" ToolTip="Ricarica" Foreground="{StaticResource AppTextDim}">
                        <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" />
                    </Button>
                </StackPanel>

                <TextBox x:Name="AddressBox" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                         Background="{StaticResource AppSurfaceAlt}" BorderThickness="0" Padding="10,7"
                         FontSize="12" KeyDown="Address_KeyDown" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="12,0"
                            Click="Go_Click" Content="Vai" />
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="30" Padding="12,0"
                            Margin="6,0,0,0" Click="OpenChat_Click" Content="Apri chat Eldorado" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" CornerRadius="10" ClipToBounds="True"
                BorderBrush="{StaticResource AppBorder}" BorderThickness="1"
                Background="{StaticResource AppSurface}">
            <Grid>
                <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />

                <!-- Shown when the WebView2 runtime is missing (stripped Windows builds) -->
                <StackPanel x:Name="MissingRuntimePanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="30">
                    <materialDesign:PackIcon Kind="WebOff" Width="56" Height="56"
                                             HorizontalAlignment="Center"
                                             Foreground="{StaticResource AppGold}" />
                    <TextBlock Text="Browser integrato non disponibile" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,12,0,0"
                               Text="Su questo PC manca il runtime Microsoft WebView2 (alcune versioni alleggerite di Windows lo rimuovono insieme a Edge). Il bot funziona lo stesso: prezzi, richieste e invio delle offerte sono attivi, e il messaggio con il banner viene copiato negli appunti da incollare in chat." />
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0"
                               Text="Per riattivare chat, accesso dal sito e invio automatico, installa WebView2 (Evergreen Standalone Installer) e riapri l'app." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Height="38" Padding="18,0" Click="Download_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource AppAccent}" BorderBrush="{StaticResource AppAccent}"
                                Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Download" VerticalAlignment="Center" />
                                <TextBlock Text="Scarica WebView2" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Height="38" Padding="16,0" Margin="10,0,0,0" Click="Retry_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Content="Riprova" />
                    </StackPanel>

                    <TextBlock x:Name="MissingRuntimeDetail" Style="{StaticResource Hint}" Visibility="Collapsed"
                               TextAlignment="Center" Margin="0,16,0,0" FontFamily="Consolas" FontSize="10.5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
