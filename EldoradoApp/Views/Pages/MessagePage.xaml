<UserControl x:Class="EldoradoApp.Views.Pages.MessagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EldoradoApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MessageViewModel}"
             d:DesignHeight="740" d:DesignWidth="1200">

    <Grid Margin="22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: composer ===== -->
        <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Switch + delivery -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="INVIO AUTOMATICO DOPO L'OFFERTA" Style="{StaticResource CardTitle}" />

                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                            <TextBlock Text="Manda il messaggio appena l'offerta parte" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>

                        <WrapPanel Margin="0,14,0,0">
                            <ComboBox Width="250" Style="{StaticResource FieldCombo}"
                                      materialDesign:HintAssist.Hint="Modalità di invio"
                                      ItemsSource="{Binding Deliveries}" SelectedItem="{Binding Delivery}" />
                            <TextBox Width="150" Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="Attesa prima (sec)"
                                     Text="{Binding DelaySeconds, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Width="140" Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="Tentativi"
                                     Text="{Binding MaxAttempts, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Width="290" Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="URL della chat Eldorado"
                                     Text="{Binding ChatUrl, UpdateSourceTrigger=LostFocus}" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding CopyToClipboard}" VerticalAlignment="Center" />
                            <TextBlock Text="Copia sempre testo e banner negli appunti (rete di sicurezza)"
                                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding AttachBanner}" VerticalAlignment="Center" />
                            <TextBlock Text="Allega il banner anche dentro la chat, dopo il testo"
                                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding StrictBuyerMatch}" VerticalAlignment="Center" />
                            <TextBlock Text="Non scrivere se non riesco a confermare il destinatario"
                                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" />
                        </StackPanel>

                        <Border Background="#22FFC857" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource Hint}" Foreground="#FFE0A0"
                                       Text="La chat di Eldorado è TalkJS e non ha un endpoint nell'API venditore: l'invio automatico avviene guidando la chat dentro la scheda «Chat» di questa app, dove devi essere loggato sul sito. Il bot apre da solo la conversazione del compratore cercando il suo nome nella lista; se non la trova o non è sicuro del destinatario non scrive niente e mette messaggio e banner negli appunti da incollare con Ctrl+V." />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Template -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="TESTO DEL MESSAGGIO" Style="{StaticResource CardTitle}" Margin="0"
                                       VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="28" Padding="10,0" Command="{Binding ResetTemplateCommand}"
                                    Content="Ripristina testo predefinito" FontSize="11"
                                    Foreground="{StaticResource AppTextDim}" />
                        </Grid>

                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxHeight="300"
                                 VerticalScrollBarVisibility="Auto" FontSize="13" />

                        <TextBlock Text="SEGNAPOSTO — clicca per inserirli" FontSize="10" FontWeight="Bold"
                                   Margin="0,14,0,8" Foreground="{StaticResource AppTextDim}" />
                        <ItemsControl ItemsSource="{Binding Placeholders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PlaceholderChip}">
                                    <Button Margin="0,0,7,7" Height="26" Padding="10,0" FontSize="11"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Content="{Binding Token}" ToolTip="{Binding Description}"
                                            Command="{Binding DataContext.InsertPlaceholderCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Token}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Banner -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="BANNER ALLEGATO" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="180" Height="100" CornerRadius="8"
                                    Background="{StaticResource AppSurfaceAlt}"
                                    BorderBrush="{StaticResource AppBorder}" BorderThickness="1">
                                <Grid>
                                    <materialDesign:PackIcon Kind="ImageOutline" Width="34" Height="34"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{StaticResource AppTextDim}"
                                                             Visibility="{Binding HasBanner,
                                                                          Converter={StaticResource InverseBoolToVis}}" />
                                    <Image Source="{Binding BannerPath}" Stretch="UniformToFill"
                                           Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BannerStatus}" Style="{StaticResource Hint}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="32"
                                            Command="{Binding PickBannerCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderImage" VerticalAlignment="Center" />
                                            <TextBlock Text="Scegli immagine" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="32"
                                            Margin="8,0,0,0" Command="{Binding ClearBannerCommand}"
                                            Content="Rimuovi" Foreground="{StaticResource AppTextDim}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Expander Background="Transparent" Foreground="{StaticResource AppText}">
                            <Expander.Header>
                                <TextBlock Text="AVANZATE · script di invio in chat" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource AppTextDim}" />
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Link diretto alla chat (opzionale)"
                                         Text="{Binding ConversationUrl, UpdateSourceTrigger=LostFocus}"
                                         FontSize="12" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                           Text="Se Eldorado espone un indirizzo che apre direttamente la conversazione, incollalo qui usando {buyer}, {buyerId} o {requestId}: il bot lo apre invece di cercare il nome nella lista." />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="Lo script sotto sostituisce solo il passaggio in cui viene scritto il testo (la conversazione la apre e la verifica comunque il bot). Lascia vuoto per quello predefinito: riceve il testo al posto di __TEXT__ e deve restituire { ok: true/false, reason: '…' }." />
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding ChatScript, UpdateSourceTrigger=LostFocus}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                         FontSize="11" MinHeight="120" MaxHeight="220"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                                <Button HorizontalAlignment="Left" Margin="0,8,0,0" Height="28"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding ResetScriptCommand}" Content="Torna allo script predefinito"
                                        Foreground="{StaticResource AppTextDim}" FontSize="11" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Right: preview + history ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AppSurface}" CornerRadius="12" Padding="18,16"
                    BorderBrush="{StaticResource AppBorder}" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ANTEPRIMA" Style="{StaticResource CardTitle}" />
                    <Border Background="{StaticResource AppSurfaceAlt}" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <Image Source="{Binding BannerPath}" MaxHeight="120" Stretch="Uniform"
                                   HorizontalAlignment="Left" Margin="0,0,0,10"
                                   Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{StaticResource AppText}" LineHeight="19" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource AppSurface}" CornerRadius="12"
                    BorderBrush="{StaticResource AppBorder}" BorderThickness="1">
                <DockPanel Margin="18,16">
                    <TextBlock DockPanel.Dock="Top" Text="MESSAGGI INVIATI" Style="{StaticResource CardTitle}" />
                    <ListBox ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SentMessageRow}">
                                <StackPanel Margin="0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource AppTextDim}" />
                                        <TextBlock Text="{Binding Buyer}" Margin="8,0,0,0" FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding Banner}" Margin="8,0,0,0" FontSize="11"
                                                   Foreground="{StaticResource AppGold}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{Binding StatusBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Button Grid.Row="2" Margin="0,14,0,0" Height="38"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{StaticResource AppAccent}" BorderBrush="{StaticResource AppAccent}"
                    Foreground="White" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                    <TextBlock Text="Salva messaggio" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
