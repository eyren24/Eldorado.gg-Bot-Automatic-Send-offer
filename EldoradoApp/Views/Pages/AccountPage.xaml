<UserControl x:Class="EldoradoApp.Views.Pages.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EldoradoApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AccountViewModel}"
             d:DesignHeight="740" d:DesignWidth="1200">

    <Grid Margin="22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: sign-in ===== -->
        <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#4A5866" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AppMint}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionStatus}" Margin="9,0,0,0" FontWeight="SemiBold"
                                           VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="28" Padding="12,0" Command="{Binding SignOutCommand}"
                                    IsEnabled="{Binding IsSignedIn}" Content="Esci"
                                    Foreground="{StaticResource AppTextDim}" />
                        </Grid>

                        <!-- Shown on machines without the WebView2 runtime -->
                        <Border Background="#22FFC857" CornerRadius="8" Padding="14,11" Margin="0,0,0,16"
                                Visibility="{Binding DataContext.IsBrowserMissing,
                                             RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" VerticalAlignment="Center"
                                                             Foreground="#FFE0A0" />
                                    <TextBlock Text="WebView2 non presente su questo PC" Margin="8,0,0,0"
                                               FontWeight="Bold" FontSize="12.5" Foreground="#FFE0A0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Foreground="#FFE0A0" Margin="0,8,0,0"
                                           Text="Il bot funziona lo stesso: richieste, calcolo prezzi e invio delle offerte non usano il browser. Accedi qui sotto con email e password (oppure incolla il token). Restano non disponibili solo: accesso dal sito, scheda Chat e invio automatico del messaggio, che verrà copiato negli appunti da incollare a mano." />
                            </StackPanel>
                        </Border>

                        <!-- Browser sign-in: the reliable route -->
                        <TextBlock Text="ACCESSO CONSIGLIATO" FontSize="10" FontWeight="Bold"
                                   Margin="0,0,0,8" Foreground="{StaticResource AppTextDim}"
                                   Visibility="{Binding DataContext.IsBrowserAvailable,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BoolToVis}}" />
                        <StackPanel Visibility="{Binding DataContext.IsBrowserAvailable,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Si apre Eldorado dentro questa finestra: premi «Login» e accedi con Google o con email e password, esattamente come su Chrome. Il bot eredita la sessione e la rinnova da solo, così non scade più." />
                            <Button HorizontalAlignment="Left" Height="42" Padding="22,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource AppAccent}" BorderBrush="{StaticResource AppAccent}"
                                    Foreground="White"
                                    Command="{Binding DataContext.SignInWithSiteCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LoginVariant" VerticalAlignment="Center" />
                                    <TextBlock Text="Accedi a Eldorado" Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <materialDesign:PackIcon Kind="Google" Width="15" Height="15"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource AppTextDim}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Text="Google è attivo su Eldorado: lo trovi come opzione nella pagina di login." />
                            </StackPanel>

                            <Separator Margin="0,16" Opacity="0.25" />
                        </StackPanel>

                        <!-- Email + password: works with no browser at all -->
                        <TextBlock Text="ACCESSO CON EMAIL E PASSWORD (API, SENZA BROWSER)" FontSize="10"
                                   FontWeight="Bold" Margin="0,0,0,10"
                                   Foreground="{StaticResource AppTextDim}" />
                        <WrapPanel>
                            <TextBox Width="260" Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="Email venditore"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            <PasswordBox x:Name="PasswordBox" Width="200" Margin="0,0,12,10"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         materialDesign:HintAssist.Hint="Password" />
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Height="38"
                                    Background="{StaticResource AppAccent}" BorderBrush="{StaticResource AppAccent}"
                                    Foreground="White" Click="SignIn_Click" IsEnabled="{Binding NotSignedIn}"
                                    Content="Accedi" />
                        </WrapPanel>

                        <Separator Margin="0,14" Opacity="0.25" />

                        <!-- Diagnostics -->
                        <TextBlock Text="DIAGNOSTICA" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"
                                   Foreground="{StaticResource AppTextDim}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="{Binding DataContext.BrowserStatus,
                                          RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button HorizontalAlignment="Left" Height="32"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource AppTextDim}"
                                IsEnabled="{Binding DataContext.IsBrowserAvailable,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding DataContext.CheckGoogleAuthCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldSearch" VerticalAlignment="Center" />
                                <TextBlock Text="Verifica se Google è attivo su Eldorado" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Background="{StaticResource AppSurfaceAlt}" CornerRadius="8" Padding="12,9"
                                Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding DataContext.GoogleAuthStatus,
                                              RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Border>

                        <Separator Margin="0,14" Opacity="0.25" />

                        <!-- Manual token -->
                        <TextBlock Text="ACCESSO CON TOKEN (INCOLLA IL JWT DAL BROWSER)" FontSize="10"
                                   FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource AppTextDim}" />
                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Incolla qui __Host-EldoradoIdToken (eyJ…)"
                                 Text="{Binding ManualTokenInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 MinHeight="62" MaxHeight="110" FontSize="11" />
                        <Button HorizontalAlignment="Left" Margin="0,10,0,0" Height="34"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding UseManualTokenCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Key" VerticalAlignment="Center" />
                                <TextBlock Text="Usa token" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Il token vale circa 30 minuti: quando scade riprendilo dal browser (DevTools → Network → una richiesta /api → header Cookie → __Host-EldoradoIdToken). Viene salvato cifrato con Windows DPAPI." />
                    </StackPanel>
                </Border>

                <!-- Polling -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="COMPORTAMENTO DEL BOT" Style="{StaticResource CardTitle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding DryRun}" VerticalAlignment="Center" />
                            <TextBlock Text="Dry-run: simula tutto senza inviare offerte" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>

                        <WrapPanel>
                            <TextBox Width="170" Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="Intervallo (secondi)"
                                     Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                            <ComboBox Width="230" Style="{StaticResource FieldCombo}"
                                      materialDesign:HintAssist.Hint="Gioco"
                                      ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                                      DisplayMemberPath="Name" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource AppMint}" />
                            <TextBlock Text="{Binding GameStatus}" Style="{StaticResource Hint}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                   Text="Le regioni accettate e i loro moltiplicatori si impostano nella scheda «Prezzi»." />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding AnswerUnknownCategories}" VerticalAlignment="Center" />
                            <TextBlock Text="Rispondi anche alle categorie non ancora configurate"
                                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" />
                        </StackPanel>

                        <Button HorizontalAlignment="Left" Margin="0,16,0,0" Height="36"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource AppAccent}" BorderBrush="{StaticResource AppAccent}"
                                Foreground="White" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                <TextBlock Text="Salva impostazioni" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Right: categories ===== -->
        <Border Grid.Column="1" Background="{StaticResource AppSurface}" CornerRadius="12"
                BorderBrush="{StaticResource AppBorder}" BorderThickness="1">
            <DockPanel Margin="18,16">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="CATEGORIE DEL GIOCO" Style="{StaticResource CardTitle}" Margin="0"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}"
                            Height="28" Padding="10,0" FontSize="11" Command="{Binding ReloadCategoriesCommand}"
                            Content="Ricarica" Foreground="{StaticResource AppTextDim}" />
                </Grid>

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                           Text="Le categorie a cui sei iscritto sul gioco selezionato. Spunta «Attiva» per farle rispondere dal bot; il prezzo arriva dal listino per divisione. Metti un «Prezzo fisso» solo per le categorie senza range di rank (es. Net Wins, Placements)." />

                <DataGrid ItemsSource="{Binding Categories}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                          HorizontalGridLinesBrush="{StaticResource AppBorder}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Attiva" Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Categoria" Width="*" IsReadOnly="True"
                                            Binding="{Binding CategoryName}" />

                        <DataGridTemplateColumn Header="Tipo prezzo" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CategoryKinds,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Bound as text, like the price list: the value lands on the settings
                             as you type, so it is saved even if the cell never loses focus. -->
                        <DataGridTextColumn Header="Prezzo fisso" Width="100"
                                            Binding="{Binding FlatPriceInput, UpdateSourceTrigger=PropertyChanged}" />

                        <DataGridTemplateColumn Header="Consegna" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.DeliveryTimeOptions,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding DeliveryTime, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
