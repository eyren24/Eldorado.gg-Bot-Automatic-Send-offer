<UserControl x:Class="EldoradoApp.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EldoradoApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}"
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid Margin="22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- ===== Requests feed ===== -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Counters -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="RICHIESTE ATTIVE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AppTextDim}" />
                        <TextBlock Text="{Binding Feed.Count}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource AppText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="QUOTABILI" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AppTextDim}" />
                        <TextBlock Text="{Binding Feed.PriceableCount}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource AppMint}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="ULTIMO AGGIORNAMENTO" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AppTextDim}" />
                        <TextBlock Text="{Binding Feed.LastUpdate}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource AppText}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Cards -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Feed.Requests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RequestRow}">
                                <Border Background="{StaticResource AppSurface}" CornerRadius="12" Margin="0,0,0,10"
                                        BorderBrush="{StaticResource AppBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{Binding RankBrush}"
                                                CornerRadius="12,0,0,12" />

                                        <StackPanel Grid.Column="1" Margin="18,14">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountCircle" Width="17" Height="17"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{StaticResource AppTextDim}" />
                                                <TextBlock Text="{Binding Buyer}" Margin="7,0,0,0" FontWeight="Bold"
                                                           VerticalAlignment="Center" FontSize="14" />
                                                <Border Background="{StaticResource AppSurfaceAlt}" CornerRadius="5"
                                                        Padding="8,2" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding RangeText}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding RankBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Created}" Margin="12,0,0,0" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AppTextDim}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding CategoryTitle}" Margin="0,7,0,0" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource AppText}" Opacity="0.85" />

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                           Foreground="{StaticResource AppTextDim}" />
                                                <TextBlock Text="{Binding ExtrasText}" Margin="10,0,0,0" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AppGold}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Padding="20,14" MinWidth="170">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding PriceText}" FontSize="21" FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource AppMint}" />
                                                <TextBlock Text="{Binding Status}" FontSize="10.5"
                                                           FontWeight="SemiBold" Margin="0,4,0,0"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{Binding StatusBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty / signed-out state -->
                <Border Background="{StaticResource AppBackground}"
                        Visibility="{Binding Feed.NotSignedIn, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                        <materialDesign:PackIcon Kind="AccountLock" Width="60" Height="60"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{StaticResource AppAccent}" />
                        <TextBlock Text="Accedi per vedere le richieste" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0"
                                   Text="Vai su «Account» e accedi con email e password, con Google, oppure incollando il token. Vedrai solo le richieste instradate al tuo account." />
                        <Button HorizontalAlignment="Center" Margin="0,20,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource AppAccent}" BorderBrush="{StaticResource AppAccent}"
                                Foreground="White"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:AppSection.Account}"
                                Content="Vai all'account" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Activity log ===== -->
        <Border Grid.Column="1" Background="{StaticResource AppSurface}" CornerRadius="12"
                BorderBrush="{StaticResource AppBorder}" BorderThickness="1">
            <DockPanel Margin="16,14">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="ATTIVITÀ DEL BOT" Style="{StaticResource CardTitle}" Margin="0"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignIconButton}" Height="26" Width="26"
                                Padding="0" Command="{Binding OpenApiLogCommand}" ToolTip="Apri il log API"
                                Foreground="{StaticResource AppTextDim}">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="15" Height="15" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" Height="26" Width="26"
                                Padding="0" Margin="4,0,0,0" Command="{Binding ClearActivityCommand}"
                                ToolTip="Pulisci" Foreground="{StaticResource AppTextDim}">
                            <materialDesign:PackIcon Kind="DeleteSweep" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ListBox ItemsSource="{Binding Activity}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,3" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AutoOfferLogItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource AppTextDim}" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding Message}" Margin="9,0,0,0" TextWrapping="Wrap"
                                           MaxWidth="280" FontSize="11.5" Foreground="{Binding Foreground}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
