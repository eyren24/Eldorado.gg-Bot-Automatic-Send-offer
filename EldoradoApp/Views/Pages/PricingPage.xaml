<UserControl x:Class="EldoradoApp.Views.Pages.PricingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EldoradoApp.ViewModels"
             xmlns:models="clr-namespace:EldoradoApp.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PricingViewModel}"
             d:DesignHeight="740" d:DesignWidth="1200">

    <Grid Margin="22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: base price + ladder ===== -->
        <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Base price and global rules -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PREZZO BASE E REGOLE" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                   Text="Ogni offerta parte dal prezzo base, poi somma il prezzo di ogni divisione che il booster deve scalare. Esempio: Gold 1 → Platinum 2 = base + Gold 1 + Gold 2 + Gold 3 + Platinum 1 + Platinum 2 (con «conta anche il rank di partenza» attivo)." />

                        <WrapPanel>
                            <TextBox Width="150" Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="Prezzo base"
                                     Text="{Binding BasePrice, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Width="110" Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="Valuta"
                                     Text="{Binding Currency, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Width="150" Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="Prezzo minimo (0 = off)"
                                     Text="{Binding MinimumPrice, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Width="160" Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="Arrotonda a (0 = off)"
                                     Text="{Binding RoundTo, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Width="150" Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="Moltiplicatore"
                                     Text="{Binding Multiplier, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            <ComboBox Width="230" Style="{StaticResource FieldCombo}"
                                      materialDesign:HintAssist.Hint="Consegna predefinita"
                                      ItemsSource="{Binding DeliveryTimes}"
                                      SelectedItem="{Binding DefaultDeliveryTime}" />
                            <ComboBox Width="260" Style="{StaticResource FieldCombo}"
                                      materialDesign:HintAssist.Hint="Come mandare il prezzo a Eldorado"
                                      ItemsSource="{Binding PriceModes}" SelectedItem="{Binding PriceMode}" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding IncludeStartDivision}" VerticalAlignment="Center" />
                            <TextBlock Text="Conta anche il rank di partenza" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="12.5" />
                            <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="(off = si pagano solo le divisioni successive)" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding SkipUnparsableRanges}" VerticalAlignment="Center" />
                            <TextBlock Text="Salta le richieste senza range di rank leggibile" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="12.5" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ladder -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="LISTINO PER DIVISIONE"
                                   Style="{StaticResource CardTitle}" />

                        <!-- Bulk helpers -->
                        <Border DockPanel.Dock="Top" Background="{StaticResource AppSurfaceAlt}" CornerRadius="8"
                                Padding="12,10" Margin="0,0,0,12">
                            <WrapPanel>
                                <TextBlock Text="Riempimento rapido:" VerticalAlignment="Center" FontSize="12"
                                           Margin="0,0,10,0" Foreground="{StaticResource AppTextDim}" />
                                <ComboBox Width="150" Margin="0,0,10,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding Tiers}" SelectedItem="{Binding BulkTier}" />
                                <TextBox Width="110" Margin="0,0,10,0" VerticalAlignment="Center"
                                         materialDesign:HintAssist.Hint="Prezzo"
                                         Text="{Binding BulkAmount, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="30"
                                        Margin="0,0,16,0" Command="{Binding ApplyBulkCommand}" Content="Applica" />
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Height="30"
                                        Command="{Binding ScaleAllCommand}" CommandParameter="1.1"
                                        Content="+10% su tutto" />
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Height="30"
                                        Command="{Binding ScaleAllCommand}" CommandParameter="0.9"
                                        Content="−10% su tutto" />
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Height="30"
                                        Command="{Binding ResetToSuggestedCommand}"
                                        Content="Listino consigliato" />
                            </WrapPanel>
                        </Border>

                        <DataGrid x:Name="LadderGrid" ItemsSource="{Binding Divisions}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent"
                                  BorderThickness="0" MaxHeight="460"
                                  HorizontalGridLinesBrush="{StaticResource AppBorder}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="#" Width="46" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Step}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{StaticResource AppTextDim}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Divisione" Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="4,0">
                                                <Border Width="10" Height="10" CornerRadius="5"
                                                        Background="{Binding TierBrush}" />
                                                <TextBlock Text="{Binding Division}" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Bound to the text, not the number: that's what makes the price
                                     apply while you type (see MoneyText). -->
                                <DataGridTextColumn Header="Prezzo divisione" Width="150"
                                                    Binding="{Binding PriceInput, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Regions: what to accept, and what it costs -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="REGIONI ACCETTATE E MOLTIPLICATORI" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Spunta le regioni su cui vuoi offrire. Il moltiplicatore alza il prezzo per le regioni fuori EU: es. 1,25 su NA significa +25% sul totale prima degli extra. La regione viene letta dal testo della richiesta." />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding AcceptAllRegions}" VerticalAlignment="Center" />
                            <TextBlock Text="Accetta tutte le regioni" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="12.5" />
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding AcceptUnknownRegion}" VerticalAlignment="Center"
                                          Margin="26,0,0,0" />
                            <TextBlock Text="Accetta anche se la regione non è indicata" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="12.5" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Regions}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  MaxHeight="330"
                                  HorizontalGridLinesBrush="{StaticResource AppBorder}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Accetta" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Accepted, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Codice" Width="80" IsReadOnly="True"
                                                    Binding="{Binding Code}" />
                                <DataGridTextColumn Header="Regione" Width="*" IsReadOnly="True"
                                                    Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Moltiplicatore" Width="130"
                                                    Binding="{Binding Multiplier, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Right: live simulator ===== -->
        <Border Grid.Column="1" Background="{StaticResource AppSurface}" CornerRadius="12"
                BorderBrush="{StaticResource AppBorder}" BorderThickness="1">
            <DockPanel Margin="18,16">
                <TextBlock DockPanel.Dock="Top" Text="SIMULATORE PREZZO" Style="{StaticResource CardTitle}" />

                <StackPanel DockPanel.Dock="Top">
                    <ComboBox Style="{StaticResource FieldCombo}" Margin="0,0,0,12"
                              materialDesign:HintAssist.Hint="Rank di partenza"
                              ItemsSource="{Binding Ladder}" SelectedItem="{Binding SimulationFrom}" />
                    <ComboBox Style="{StaticResource FieldCombo}" Margin="0,0,0,12"
                              materialDesign:HintAssist.Hint="Rank di destinazione"
                              ItemsSource="{Binding Ladder}" SelectedItem="{Binding SimulationTo}" />
                    <ComboBox Style="{StaticResource FieldCombo}" Margin="0,0,0,10"
                              materialDesign:HintAssist.Hint="Regione"
                              ItemsSource="{Binding RegionCodes}" SelectedItem="{Binding SimulationRegion}" />

                    <Border Background="{StaticResource AppSurfaceAlt}" CornerRadius="10" Padding="16,14"
                            Margin="0,4,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SimulationTotal}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource AppMint}" />
                            <TextBlock Text="{Binding SimulationRange}" Style="{StaticResource Hint}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DETTAGLIO" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{StaticResource AppTextDim}" />
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Margin="0,12,0,0" Height="38"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AppAccent}" BorderBrush="{StaticResource AppAccent}"
                        Foreground="White" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                        <TextBlock Text="Salva listino" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SimulationLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PriceLine}">
                                <Grid Margin="0,3">
                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                               Foreground="{StaticResource AppText}" Opacity="0.9" />
                                    <TextBlock Text="{Binding Amount, StringFormat='+{0:N2}'}" FontSize="12"
                                               HorizontalAlignment="Right" FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextDim}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
