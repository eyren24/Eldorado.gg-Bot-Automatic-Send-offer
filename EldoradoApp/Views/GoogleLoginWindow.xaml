<Window x:Class="EldoradoApp.Views.GoogleLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStartupLocation="CenterOwner"
        Title="Accedi con Google · Eldorado" Height="720" Width="520">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFF8E1" Padding="12,8">
            <TextBlock TextWrapping="Wrap" Foreground="#5D4037" FontSize="12"
                       Text="Accedi al tuo account Eldorado. Se vedi «Login pages unavailable», Google non è ancora abilitato da Eldorado per il bot: chiudi e usa email + password." />
        </Border>
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
