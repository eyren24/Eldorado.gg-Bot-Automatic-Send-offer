<Window x:Class="EldoradoApp.Views.BoostingBotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:EldoradoApp.ViewModels"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        d:DataContext="{d:DesignInstance vm:BoostingBotViewModel}"
        WindowStartupLocation="CenterOwner"
        Title="Bot Auto-Offerta" Height="860" Width="1200">

    <DockPanel>
        <!-- App bar -->
        <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="20,14"
                                  materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Robot" Width="28" Height="28" VerticalAlignment="Center" />
                    <TextBlock Text="BOT AUTO-OFFERTA · Boosting" FontSize="20" FontWeight="Bold"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Circle" Width="12" Height="12" VerticalAlignment="Center"
                                             Margin="0,0,6,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Foreground" Value="#777" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                        <Setter Property="Foreground" Value="#69F0AE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" FontWeight="Medium" />
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#22000000" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding StartBotCommand}" IsEnabled="{Binding NotRunning}"
                            Background="#2E7D32" BorderBrush="#2E7D32">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" />
                            <TextBlock Text="Avvia bot" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="10,0,0,0"
                            Command="{Binding StopBotCommand}" IsEnabled="{Binding IsRunning}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stop" VerticalAlignment="Center" />
                            <TextBlock Text="Ferma" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveCommand}" Content="Salva impostazioni" />
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: config (scrollable so the rank grid is always reachable) -->
            <ScrollViewer Grid.Column="0" Margin="0,0,10,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                <!-- Connection -->
                <materialDesign:Card Padding="16" Margin="0,0,0,10"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="ACCOUNT ELDORADO" FontWeight="Bold" Opacity="0.7" FontSize="12"
                                       VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding SignOutCommand}" IsEnabled="{Binding IsSignedIn}"
                                    Content="Esci" Padding="8,2" />
                        </Grid>

                        <!-- Email + password -->
                        <TextBlock Text="Accesso con email e password" FontWeight="SemiBold" Opacity="0.75"
                                   FontSize="12" Margin="0,0,0,6" />
                        <WrapPanel>
                            <TextBox Width="260" Margin="0,0,12,8"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Email venditore"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            <PasswordBox x:Name="PasswordBox" Width="200" Margin="0,0,12,8"
                                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                         materialDesign:HintAssist.Hint="Password" />
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,8"
                                    Click="SignIn_Click" IsEnabled="{Binding NotSignedIn}" Content="Accedi" />
                        </WrapPanel>

                        <!-- Divider -->
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Separator Grid.Column="0" VerticalAlignment="Center" Opacity="0.4" />
                            <TextBlock Grid.Column="1" Text="oppure" Opacity="0.5" FontSize="11" Margin="10,0" />
                            <Separator Grid.Column="2" VerticalAlignment="Center" Opacity="0.4" />
                        </Grid>

                        <!-- Google -->
                        <TextBlock Text="Accesso con Google" FontWeight="SemiBold" Opacity="0.75"
                                   FontSize="12" Margin="0,0,0,6" />
                        <Button HorizontalAlignment="Left" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="SignInGoogle_Click" IsEnabled="{Binding NotSignedIn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Google" VerticalAlignment="Center" />
                                <TextBlock Text="Accedi con Google" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Divider -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Separator Grid.Column="0" VerticalAlignment="Center" Opacity="0.4" />
                            <TextBlock Grid.Column="1" Text="oppure" Opacity="0.5" FontSize="11" Margin="10,0" />
                            <Separator Grid.Column="2" VerticalAlignment="Center" Opacity="0.4" />
                        </Grid>

                        <!-- Manual token (paste IdToken from a logged-in browser) -->
                        <TextBlock Text="Accesso con token (incolla il JWT dal browser)" FontWeight="SemiBold"
                                   Opacity="0.75" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Incolla qui __Host-EldoradoIdToken (eyJ…)"
                                 Text="{Binding ManualTokenInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 MinHeight="60" MaxHeight="110" />
                        <Button HorizontalAlignment="Left" Margin="0,8,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding UseManualTokenCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Key" VerticalAlignment="Center" />
                                <TextBlock Text="Usa token" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,10,0,0"
                                   Text="Il token vale ~30 min: quando scade, riprendilo dal browser (DevTools → Network → richiesta /api → header Cookie → __Host-EldoradoIdToken) e reincollalo. È cifrato con Windows DPAPI. Google ed email/password sono pronti ma dipendono dalla configurazione di Eldorado." />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Bot controls -->
                <materialDesign:Card Padding="16" Margin="0,0,0,10"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="CONTROLLO BOT" FontWeight="Bold" Opacity="0.7" FontSize="12"
                                   Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding DryRun}" />
                            <TextBlock Text="Dry-run (simula, non invia)" VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                            <TextBlock VerticalAlignment="Center" Margin="20,0,0,0" Opacity="0.6"
                                       Text="Usa «Avvia bot» in basso per partire/fermare." />
                        </StackPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBox Width="120" Margin="0,0,16,8"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Intervallo (s)"
                                     Text="{Binding PollIntervalSeconds}" />
                            <TextBox Width="100" Margin="0,0,16,8"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Valuta" Text="{Binding Currency}" />
                            <ComboBox Width="200" Margin="0,0,16,8"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      materialDesign:HintAssist.Hint="Gioco"
                                      ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                                      DisplayMemberPath="Name" />
                            <TextBox Width="200" Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Regioni accettate (es. EU, NA)"
                                     Text="{Binding AcceptedRegionsText}" />
                        </WrapPanel>

                        <!-- Custom message -->
                        <TextBox Margin="0,4,0,0"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Messaggio personalizzato (modificabile in qualsiasi momento)"
                                 Text="{Binding OfferMessage, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 MinHeight="56" MaxHeight="120" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,4,0,0"
                                   Text="Nota: l'API ufficiale di Eldorado non permette di inviare un messaggio testuale automatico (la chat è TalkJS, esterna). Il messaggio viene mostrato nel log dell'offerta e potrai incollarlo nella chat del compratore." />
                        <Border Background="#33FF5252" CornerRadius="4" Padding="10,6" Margin="0,6,0,0"
                                Visibility="{Binding DryRun, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Alert" VerticalAlignment="Center" Foreground="#FF8A80" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FFCDD2"
                                           Text="DRY-RUN DISATTIVATO: con bot attivo le offerte vengono inviate davvero." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Per-category price list -->
                <materialDesign:Card Padding="12" materialDesign:ElevationAssist.Elevation="Dp2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="LISTINO PER CATEGORIA"
                                   FontWeight="Bold" Opacity="0.7" FontSize="12" Margin="4,2,4,8" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.6" FontSize="11"
                                   Margin="4,0,4,8"
                                   Text="Categorie del gioco selezionato (dalle tue iscrizioni). Per ognuna imposta prezzo per unità, quantità min/max e tempo di consegna. Spunta «Attiva» per offrire su quella categoria. Il rank specifico si concorda in chat." />
                        <DataGrid ItemsSource="{Binding CategoryRows}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Attiva" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Categoria" Width="*" IsReadOnly="True"
                                                    Binding="{Binding CategoryName}" />
                                <DataGridTextColumn Header="Prezzo / unità" Width="110"
                                                    Binding="{Binding PricePerUnit, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Qta min" Width="70"
                                                    Binding="{Binding MinQuantity, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Qta max" Width="70"
                                                    Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Header="Consegna" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.DeliveryTimeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding DeliveryTime, UpdateSourceTrigger=PropertyChanged}"
                                                      BorderThickness="0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: activity log -->
            <materialDesign:Card Grid.Column="1" Padding="12" materialDesign:ElevationAssist.Elevation="Dp2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ATTIVITÀ LIVE" FontWeight="Bold" Opacity="0.7"
                               FontSize="12" Margin="4,2,4,8" />
                    <ListBox ItemsSource="{Binding Activity}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AutoOfferLogItem}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Time}" Opacity="0.5" Margin="0,0,8,0"
                                               FontFamily="Consolas" />
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Color}"
                                               TextWrapping="Wrap" MaxWidth="320" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </DockPanel>
</Window>
