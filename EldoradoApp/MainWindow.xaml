<Window x:Class="EldoradoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:EldoradoApp.ViewModels"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        d:DataContext="{d:DesignInstance vm:RequestsFeedViewModel}"
        Title="Eldorado · Valorant Boosting" Height="800" Width="1200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App bar -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="20,14"
                                  materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SwordCross" Width="30" Height="30" VerticalAlignment="Center" />
                    <TextBlock Text="VALORANT · Richieste boosting" Margin="14,0,0,0"
                               FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Circle" Width="12" Height="12" VerticalAlignment="Center"
                                             Margin="0,0,6,0"
                                             Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"
                                             Foreground="#69F0AE" />
                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding IsLive}" VerticalAlignment="Center" />
                    <TextBlock Text="LIVE" Margin="8,0,0,0" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Margin="16,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Aggiorna ora"
                            Style="{StaticResource MaterialDesignIconButton}">
                        <materialDesign:PackIcon Kind="Refresh" />
                    </Button>
                    <Button Margin="4,0,0,0" Click="OnBotClick" ToolTip="Bot auto-offerta · impostazioni">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Robot" VerticalAlignment="Center" />
                            <TextBlock Text="Bot" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Requests feed -->
        <Grid Grid.Row="1">
            <ScrollViewer Margin="16,12" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Requests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RequestRow}">
                            <materialDesign:Card Margin="0,5" UniformCornerRadius="8"
                                                 materialDesign:ElevationAssist.Elevation="Dp2">
                                <Grid Height="92">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{Binding DesiredRankBrush}" />

                                    <!-- Rank badges -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="18,0">
                                        <Border Background="{Binding CurrentRankBrush}" CornerRadius="4" Padding="10,5">
                                            <TextBlock Text="{Binding CurrentRank}" FontWeight="SemiBold" Foreground="#111" />
                                        </Border>
                                        <materialDesign:PackIcon Kind="ArrowRightBold" VerticalAlignment="Center"
                                                                 Margin="8,0" Opacity="0.7" />
                                        <Border Background="{Binding DesiredRankBrush}" CornerRadius="4" Padding="10,5">
                                            <TextBlock Text="{Binding DesiredRank}" FontWeight="SemiBold" Foreground="#111" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Buyer + category -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="22,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountCircle" Width="18" Height="18"
                                                                     Opacity="0.7" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Buyer}" Margin="6,0,0,0" FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                            <Border Margin="10,0,0,0" Background="#33FFFFFF" CornerRadius="3"
                                                    Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Region}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CategoryTitle}" Opacity="0.6" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Created -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="16,0">
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16"
                                                                 Opacity="0.6" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Created}" Margin="6,0,0,0" Opacity="0.7"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Computed offer -->
                                    <Border Grid.Column="4" Background="#14FFFFFF" Padding="22,0" Margin="16,0,0,0">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding PriceText}" FontSize="19" FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource SecondaryHueMidBrush}" />
                                            <TextBlock Text="{Binding TimeText}" Opacity="0.7" FontSize="11"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0"
                                                       Foreground="{Binding StatusBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Not signed in overlay -->
            <Border Background="{DynamicResource MaterialDesignPaper}"
                    Visibility="{Binding NotSignedIn, Converter={StaticResource BoolToVis}}">
                <materialDesign:Card HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Padding="44,36" UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp3">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                        <materialDesign:PackIcon Kind="AccountLock" Width="64" Height="64"
                                                 HorizontalAlignment="Center" Opacity="0.85"
                                                 Foreground="{DynamicResource SecondaryHueMidBrush}" />
                        <TextBlock Text="Accedi per vedere le richieste" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" Margin="0,10,0,0"
                                   Text="Apri il Bot e accedi con l'account venditore. Le richieste mostrate sono solo quelle instradate al tuo account (in base alle tue iscrizioni)." />
                        <Button HorizontalAlignment="Center" Margin="0,22,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}" Click="OnBotClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Robot" VerticalAlignment="Center" />
                                <TextBlock Text="Apri Bot e accedi" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Border>
        </Grid>

        <!-- Status bar -->
        <materialDesign:ColorZone Grid.Row="2" Mode="PrimaryDark" Padding="20,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Opacity="0.85"
                           Text="{Binding Count, StringFormat='Richieste: {0}'}" />
                <TextBlock Text="{Binding StatusMessage}" FontWeight="Medium" />
            </DockPanel>
        </materialDesign:ColorZone>
    </Grid>
</Window>
