<Window x:Class="EldoradoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:EldoradoApp.ViewModels"
        xmlns:pages="clr-namespace:EldoradoApp.Views.Pages"
        mc:Ignorable="d"
        TextElement.Foreground="{StaticResource AppText}"
        Background="{StaticResource AppBackground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextOptions.TextFormattingMode="Ideal"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        Title="Eldorado · Boosting Bot" Height="920" Width="1480" MinHeight="700" MinWidth="1180"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="242" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ NAVIGATION RAIL ============ -->
        <Border Grid.Column="0" Background="{StaticResource AppRail}"
                BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AppAccent}" CornerRadius="8" Width="34" Height="34">
                            <materialDesign:PackIcon Kind="Robot" Width="20" Height="20" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ELDORADO BOT" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource AppText}" />
                            <TextBlock Text="Valorant boosting" FontSize="10.5"
                                       Foreground="{StaticResource AppTextDim}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Bot control, pinned to the bottom -->
                <Border DockPanel.Dock="Bottom" Margin="14,10,14,16" Padding="14"
                        Background="{StaticResource AppSurface}" CornerRadius="12"
                        BorderBrush="{StaticResource AppBorder}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#4A5866" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AppMint}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="8,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{StaticResource AppTextDim}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="BOT FERMO" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="BOT IN ESECUZIONE" />
                                                <Setter Property="Foreground" Value="{StaticResource AppMint}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Button Command="{Binding StartBotCommand}" IsEnabled="{Binding NotRunning}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource AppAccent}" BorderBrush="{StaticResource AppAccent}"
                                Foreground="White" Height="36">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" />
                                <TextBlock Text="Avvia bot" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding StopBotCommand}" IsEnabled="{Binding IsRunning}" Margin="0,8,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop" VerticalAlignment="Center" />
                                <TextBlock Text="Ferma" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RunOnceCommand}" Margin="0,6,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}" Height="30"
                                Foreground="{StaticResource AppTextDim}" FontSize="11"
                                Content="Esegui un ciclo singolo" />

                        <Border Background="#33FF4655" CornerRadius="8" Padding="10,7" Margin="0,10,0,0"
                                Visibility="{Binding IsArmed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⚠ LIVE: le offerte partono davvero" FontSize="10.5"
                                       TextWrapping="Wrap" Foreground="#FFCDD2" />
                        </Border>

                        <!-- Renewal nag: only in the last few days, and it opens the page.
                             Height/MinHeight are overridden because the Material button
                             style pins them to 32px, which would clip the wrapped text. -->
                        <Button Margin="0,10,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                                Height="Auto" MinHeight="0" MinWidth="0"
                                HorizontalContentAlignment="Stretch" Cursor="Hand"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:AppSection.License}"
                                Visibility="{Binding IsLicenseExpiringSoon, Converter={StaticResource BoolToVis}}">
                            <Border Background="#22FFC857" CornerRadius="8" Padding="10,7">
                                <TextBlock Text="{Binding LicenseWarning}" FontSize="10.5"
                                           TextWrapping="Wrap" Foreground="#FFE0A0" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Sections -->
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding Icon}" Width="20" Height="20"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center"
                                           FontSize="13.5" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ CONTENT ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource AppRail}" Padding="26,16"
                    BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding SectionHint}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{StaticResource AppSurface}" CornerRadius="8" Padding="12,7"
                                BorderBrush="{StaticResource AppBorder}" BorderThickness="1" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SendCheck" Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource AppMint}" />
                                <TextBlock Text="{Binding OffersSent}" Margin="7,0,0,0" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="offerte" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource AppTextDim}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource AppSurface}" CornerRadius="8" Padding="12,7"
                                BorderBrush="{StaticResource AppBorder}" BorderThickness="1" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Trophy" Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource AppGold}" />
                                <TextBlock Text="{Binding OffersWon}" Margin="7,0,0,0" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="accettate" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource AppTextDim}" />
                            </StackPanel>
                        </Border>

                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      IsChecked="{Binding Feed.IsLive}" VerticalAlignment="Center"
                                      ToolTip="Aggiornamento automatico del feed" />
                        <TextBlock Text="LIVE" Margin="9,0,0,0" FontWeight="Bold" FontSize="12"
                                   VerticalAlignment="Center" />

                        <Button Margin="12,0,0,0" Command="{Binding Feed.RefreshCommand}"
                                Style="{StaticResource MaterialDesignIconButton}" ToolTip="Aggiorna adesso"
                                Foreground="{StaticResource AppTextDim}">
                            <materialDesign:PackIcon Kind="Refresh" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pages: all alive, only one visible (the browser must keep its session) -->
            <Grid Grid.Row="1">
                <pages:DashboardPage DataContext="{Binding}"
                                     Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window},
                                                  Converter={StaticResource EqualsToVis}, ConverterParameter=Dashboard}" />

                <pages:PricingPage DataContext="{Binding Pricing}"
                                   Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource EqualsToVis}, ConverterParameter=Pricing}" />

                <pages:UnitsPage DataContext="{Binding Units}"
                                 Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource EqualsToVis}, ConverterParameter=Units}" />

                <pages:ExtrasPage DataContext="{Binding Extras}"
                                  Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource EqualsToVis}, ConverterParameter=Extras}" />

                <pages:MessagePage DataContext="{Binding Message}"
                                   Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource EqualsToVis}, ConverterParameter=Message}" />

                <pages:ChatPage x:Name="ChatPanel"
                                Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource EqualsToVis}, ConverterParameter=Chat}" />

                <pages:AccountPage DataContext="{Binding Account}"
                                   Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource EqualsToVis}, ConverterParameter=Account}" />

                <pages:LicensePage DataContext="{Binding License}"
                                   Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource EqualsToVis}, ConverterParameter=License}" />
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource AppRail}" Padding="26,10"
                    BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AppTextDim}" FontSize="11.5"
                               Text="{Binding Feed.StatusMessage}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="Medium"
                               Foreground="{StaticResource AppText}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ IN-APP LOGIN OVERLAY (no separate window) ============ -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#E60B0F14"
                Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVis}}">
            <!-- Sized by margin so the Eldorado login always has room, on any screen -->
            <Border Margin="70,40" MaxWidth="1180" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{StaticResource AppSurface}" CornerRadius="14"
                    BorderBrush="{StaticResource AppBorder}" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Google" VerticalAlignment="Center"
                                                     Foreground="{StaticResource AppAccent}" />
                            <TextBlock Text="{Binding LoginTitle}" Margin="10,0,0,0" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Height="32" Padding="14,0" VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource AppMint}" BorderBrush="{StaticResource AppMint}"
                                    Foreground="#0B0F14" Command="{Binding ConfirmLoginCommand}"
                                    ToolTip="Se sei già dentro, prendi la sessione adesso">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center" />
                                    <TextBlock Text="Ho fatto l'accesso" Margin="7,0,0,0"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding CancelLoginCommand}" ToolTip="Annulla accesso"
                                    Foreground="{StaticResource AppTextDim}">
                                <materialDesign:PackIcon Kind="Close" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" Background="#1F2A36" Padding="16,10">
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding LoginHint}" />
                    </Border>

                    <wv2:WebView2 x:Name="LoginBrowser" Margin="0,0,0,0" />
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
